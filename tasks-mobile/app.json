{
  "expo": {
    "name": "Peacee1 Task",
    "slug": "peacee1-task",
    "owner": "peacee12",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "peacee1task",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.peacee1.task",
      "buildNumber": "7",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "requireFullScreen": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "PORTRAIT_UP"
        }
      ],
      "./plugins/withTaskNoteWidget",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.peacee1.task.widgets",
          "groupIdentifier": "group.com.peacee1.task",
          "widgets": [
            {
              "name": "TaskNoteWidget",
              "displayName": "Tờ note",
              "description": "Những việc cần làm trên một tờ ghi chú.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "systemLarge"
                ],
                "contentMarginsDisabled": true
              }
            }
          ]
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9a556094-84fc-40c4-8dcd-f3672bcef9ca"
      }
    }
  }
}
